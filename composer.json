{
    "name": "pokedb/pokeapi-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Pascal Kleindienst",
            "email": "mail@pascalkleindienst.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "PokeDB\\PokeApiClient\\": "src/",
            "PokeDB\\PokeApiClient\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2.0",
        "ext-curl": "*",
        "psr/cache": "^2.0.0|^3.0.0",
        "symfony/cache": "^6.3"
    },
    "scripts": {
        "test": "XDEBUG_MODE=coverage pest --coverage",
        "phpcs": [
            "phpcs --standard=.phpcs.xml -s"
        ],
        "phpstan": [
            "phpstan analyze --memory-limit=2G"
        ],
        "static-analyze": [
            "@phpstan"
        ]
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpmd/phpmd": "^2.14",
        "symfony/var-dumper": "^6.4",
        "pestphp/pest": "^2.35"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
